# Universal OpenAPI MCP Server Environment Variables
# =======================================================
# This file contains all possible environment variables for the Universal OpenAPI MCP Server.
# Copy this file to .env and fill in your values.
# 
# Quick Start:
# 1. Copy this file: cp .env.example .env
# 2. Fill in the required values (API_NAME, API_BASE_URL, OPENAPI_SPEC_URL)
# 3. Configure authentication if needed
# 4. Run the server: npm run dev
#
# =======================================================

# ====================
# BASIC CONFIGURATION (Required)
# ====================

# API Name - A unique identifier for your API
# This is used to identify the API in logs and when switching between multiple APIs
# Examples: github, stripe, petstore, my-internal-api
API_NAME=my-api

# API Base URL - The base URL of your API
# This should include the protocol (https://) and any base path
# Examples:
#   https://api.github.com
#   https://api.stripe.com/v1
#   https://petstore.swagger.io/v2
#   http://localhost:3000/api
API_BASE_URL=https://api.example.com

# OpenAPI Specification URL - Where to fetch the OpenAPI/Swagger specification
# This can be:
# 1. A public URL: https://api.example.com/openapi.json
# 2. A GitHub raw URL: https://raw.githubusercontent.com/...
# 3. A local file path: ./specs/my-api.yaml
# The spec must be OpenAPI 3.x or Swagger 2.0 compliant
OPENAPI_SPEC_URL=https://api.example.com/openapi.json

# ====================
# OPTIONAL CONFIGURATION
# ====================

# Request timeout in milliseconds (optional, default: 30000 = 30 seconds)
# Increase this for APIs with slow endpoints
# Examples: 15000 (15 sec), 60000 (1 min), 120000 (2 min)
API_TIMEOUT=30000

# ====================
# AUTHENTICATION OPTIONS
# ====================
# Choose ONE authentication method below and uncomment the relevant section

# Authentication Type - Leave empty if the API doesn't require authentication
# Valid options: apiKey, bearer, basic, oauth2
AUTH_TYPE=

# -----------------------------
# Option 1: API Key Authentication
# -----------------------------
# Use when the API requires an API key in headers or query parameters

# Uncomment these lines for API Key auth:
# AUTH_TYPE=apiKey
# API_KEY=your-api-key-here
# API_KEY_LOCATION=header                    # Where to send the key: 'header' or 'query'
# API_KEY_NAME=X-API-Key                     # The name of the header/query parameter

# Common API key header names by service:
# - X-API-Key: Generic APIs
# - Authorization: Some services use "Authorization: API-Key YOUR_KEY"
# - X-RapidAPI-Key: RapidAPI services
# - api-key: Azure services
# - X-Auth-Token: Some REST APIs
# - access_token: When passed as query parameter

# -----------------------------
# Option 2: Bearer Token Authentication  
# -----------------------------
# Use for JWT tokens, OAuth access tokens, or any Bearer-style authentication

# Uncomment these lines for Bearer auth:
# AUTH_TYPE=bearer
# BEARER_TOKEN=your-bearer-token-here        # The token will be sent as "Authorization: Bearer TOKEN"

# You can also use AUTH_TOKEN instead of BEARER_TOKEN:
# AUTH_TOKEN=your-bearer-token-here

# -----------------------------
# Option 3: Basic Authentication
# -----------------------------
# Use when the API requires username and password (HTTP Basic Auth)

# Uncomment these lines for Basic auth:
# AUTH_TYPE=basic
# AUTH_USERNAME=your-username
# AUTH_PASSWORD=your-password

# -----------------------------
# Option 4: OAuth2 Authentication
# -----------------------------
# Use for OAuth2 client credentials flow

# Uncomment these lines for OAuth2:
# AUTH_TYPE=oauth2
# OAUTH2_CLIENT_ID=your-client-id
# OAUTH2_CLIENT_SECRET=your-client-secret
# OAUTH2_TOKEN_URL=https://api.example.com/oauth/token
# OAUTH2_SCOPE=read write                    # Space-separated list of scopes
# OAUTH2_GRANT_TYPE=client_credentials       # Usually 'client_credentials' for server-to-server

# ====================
# CUSTOM HEADERS
# ====================
# Add any custom headers by prefixing with HEADER_
# The HEADER_ prefix will be removed and underscores converted to hyphens
# Examples:
#   HEADER_USER_AGENT → User-Agent
#   HEADER_X_CUSTOM_ID → X-Custom-Id
#   HEADER_CONTENT_TYPE → Content-Type

# User-Agent header (optional, default: Universal-OpenAPI-MCP/1.0)
HEADER_USER_AGENT=MyApp/1.0

# Accept header (useful for APIs that support multiple response formats)
HEADER_ACCEPT=application/json

# Custom headers examples (uncomment as needed):
# HEADER_X_REQUEST_ID=req_123456
# HEADER_X_CLIENT_VERSION=2.0
# HEADER_X_TENANT_ID=tenant_abc
# HEADER_CONTENT_TYPE=application/json

# ====================
# YAML CONFIGURATION MODE
# ====================
# Instead of using environment variables, you can use a YAML configuration file
# This is useful when:
# - You need to configure multiple APIs
# - You want to version control your configuration
# - You have complex authentication setups

# To use YAML configuration, uncomment one of these:
# CONFIG_FILE=./config.yaml
# MCP_CONFIG_FILE=./my-custom-config.yaml

# Note: YAML configuration takes precedence over environment variables

# ====================
# REAL-WORLD EXAMPLES
# ====================
# Below are working examples for popular APIs. 
# Uncomment and modify the section for your API.

# -----------------------------
# GitHub API Example
# -----------------------------
# API_NAME=github
# API_BASE_URL=https://api.github.com
# OPENAPI_SPEC_URL=https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.json
# AUTH_TYPE=bearer
# BEARER_TOKEN=ghp_your_github_personal_access_token_here
# HEADER_ACCEPT=application/vnd.github.v3+json
# HEADER_X_GITHUB_API_VERSION=2022-11-28

# -----------------------------
# Stripe API Example
# -----------------------------
# API_NAME=stripe
# API_BASE_URL=https://api.stripe.com
# OPENAPI_SPEC_URL=https://raw.githubusercontent.com/stripe/openapi/master/openapi/spec3.json
# AUTH_TYPE=bearer
# BEARER_TOKEN=sk_test_your_stripe_secret_key_here
# HEADER_STRIPE_VERSION=2023-10-16

# -----------------------------
# OpenAI API Example
# -----------------------------
# API_NAME=openai
# API_BASE_URL=https://api.openai.com
# OPENAPI_SPEC_URL=https://raw.githubusercontent.com/openai/openai-openapi/master/openapi.yaml
# AUTH_TYPE=bearer
# BEARER_TOKEN=sk-your-openai-api-key-here
# HEADER_OPENAI_BETA=assistants=v2

# -----------------------------
# Anthropic API Example
# -----------------------------
# API_NAME=anthropic
# API_BASE_URL=https://api.anthropic.com
# OPENAPI_SPEC_URL=https://api.anthropic.com/openapi.json
# AUTH_TYPE=apiKey
# API_KEY=sk-ant-your-anthropic-api-key
# API_KEY_LOCATION=header
# API_KEY_NAME=x-api-key
# HEADER_ANTHROPIC_VERSION=2023-06-01

# -----------------------------
# SendGrid API Example
# -----------------------------
# API_NAME=sendgrid
# API_BASE_URL=https://api.sendgrid.com/v3
# OPENAPI_SPEC_URL=https://raw.githubusercontent.com/sendgrid/sendgrid-oai/main/oai.json
# AUTH_TYPE=bearer
# BEARER_TOKEN=SG.your_sendgrid_api_key_here

# -----------------------------
# Twilio API Example
# -----------------------------
# API_NAME=twilio
# API_BASE_URL=https://api.twilio.com/2010-04-01
# OPENAPI_SPEC_URL=https://raw.githubusercontent.com/twilio/twilio-oai/main/spec/yaml/twilio_api_v2010.yaml
# AUTH_TYPE=basic
# AUTH_USERNAME=your_account_sid
# AUTH_PASSWORD=your_auth_token

# -----------------------------
# PetStore Example (Testing - No Auth Required)
# -----------------------------
# API_NAME=petstore
# API_BASE_URL=https://petstore.swagger.io/v2
# OPENAPI_SPEC_URL=https://petstore.swagger.io/v2/swagger.json
# No authentication required

# -----------------------------
# JSONPlaceholder Example (Testing - No Auth Required)
# -----------------------------
# API_NAME=jsonplaceholder
# API_BASE_URL=https://jsonplaceholder.typicode.com
# OPENAPI_SPEC_URL=https://jsonplaceholder.typicode.com/openapi.json
# No authentication required

# -----------------------------
# Custom Internal API Example
# -----------------------------
# API_NAME=internal-api
# API_BASE_URL=https://api.internal.company.com
# OPENAPI_SPEC_URL=./specs/internal-api.yaml      # Local file
# AUTH_TYPE=apiKey
# API_KEY=${INTERNAL_API_KEY}                      # Reference another env var
# API_KEY_LOCATION=header
# API_KEY_NAME=X-Company-API-Key
# HEADER_X_TENANT_ID=tenant_123
# HEADER_X_CLIENT_VERSION=2.0
# API_TIMEOUT=60000                                # 1 minute timeout

# -----------------------------
# Azure API Example
# -----------------------------
# API_NAME=azure-resource-manager
# API_BASE_URL=https://management.azure.com
# OPENAPI_SPEC_URL=https://raw.githubusercontent.com/Azure/azure-rest-api-specs/main/specification/resources/resource-manager/Microsoft.Resources/stable/2021-04-01/resources.json
# AUTH_TYPE=bearer
# BEARER_TOKEN=your_azure_access_token
# HEADER_CONTENT_TYPE=application/json

# -----------------------------
# Slack API Example
# -----------------------------
# API_NAME=slack
# API_BASE_URL=https://slack.com/api
# OPENAPI_SPEC_URL=https://raw.githubusercontent.com/slackapi/slack-api-specs/master/web-api/slack_web_openapi_v2.json
# AUTH_TYPE=bearer
# BEARER_TOKEN=xoxb-your-slack-bot-token

# ====================
# TROUBLESHOOTING TIPS
# ====================
# 
# 1. "No OpenAPI spec URL or path provided" error:
#    - Make sure OPENAPI_SPEC_URL is set and the URL is accessible
#    - Try opening the URL in your browser to verify it returns a valid spec
#
# 2. Authentication errors:
#    - Double-check your API key/token is correct and not expired
#    - Verify you're using the correct AUTH_TYPE for your API
#    - Some APIs require specific header names - check the API documentation
#
# 3. 404 Not Found errors:
#    - Ensure API_BASE_URL includes the full base path (e.g., /v2, /api/v1)
#    - Use the api_paths_list tool to see available endpoints
#    - Check that you're not duplicating path segments
#
# 4. Timeout errors:
#    - Increase API_TIMEOUT value (e.g., 60000 for 1 minute)
#    - Some APIs have slow endpoints that need longer timeouts
#
# 5. SSL/TLS errors:
#    - For local/development APIs, you might need to handle self-signed certificates
#    - This requires additional configuration in the source code
