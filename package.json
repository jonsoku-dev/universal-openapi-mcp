{
  "name": "universal-openapi-mcp",
  "version": "1.0.0",
  "description": "Universal OpenAPI MCP Server for Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "universal-openapi-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npx fastmcp dev src/index.ts",
    "inspect": "npx fastmcp inspect src/index.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "list": "node scripts/dev.js list",
    "generate": "node scripts/dev.js generate",
    "parse-prd": "node scripts/dev.js parse-prd",
    "release": "release-it"
  },
  "keywords": [
    "mcp",
    "openapi",
    "model-context-protocol",
    "fastmcp",
    "api-client",
    "swagger"
  ],
  "author": "Jong Seok Lee",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@readme/openapi-parser": "^4.0.0",
    "@types/swagger-parser": "^4.0.3",
    "axios": "^1.9.0",
    "boxen": "^8.0.1",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "fastmcp": "^2.1.0",
    "figlet": "^1.8.0",
    "fuse.js": "^7.0.0",
    "gradient-string": "^3.0.0",
    "helmet": "^8.1.0",
    "inquirer": "^12.5.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.2.0",
    "openai": "^4.89.0",
    "openapi-types": "^12.1.3",
    "ora": "^8.2.0",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.21",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "release-it": "^19.0.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "release-it": {
    "hooks": {
      "before:init": ["npm run build"]
    },
    "git": {
      "commitMessage": "chore(release): v${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  }
}
